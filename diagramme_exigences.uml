@startuml
"Diagramme d'exigences" as Title

skinparam requirementBorderColor DarkBlue
skinparam requirementBackgroundColor LightBlue
skinparam requirementFontColor Black
skinparam requirementFontSize 12

package "Exigences du système de gestion de parc" {
    requirement "R1 - Authentification centralisée" as R1 {
        Garantir l'accès aux utilisateurs et administrateurs via Active Directory.
    }

    requirement "R2 - Gestion des identités et des accès" as R2 {
        Permettre la création, modification et validation des comptes et des droits.
    }

    requirement "R3 - Déploiement automatisé" as R3 {
        Déployer des applications et configurations sur les postes via Ansible.
    }

    requirement "R4 - Politiques de sécurité" as R4 {
        Appliquer et maintenir des règles de sécurité centralisées.
    }

    requirement "R5 - Mise à jour et correctifs" as R5 {
        Appliquer les mises à jour et correctifs après validation des politiques de sécurité.
    }

    requirement "R6 - Reporting et supervision" as R6 {
        Collecter des informations d'inventaire et générer des rapports de conformité.
    }
}

R2 -[#blue]-> R1 : <<refine>>
R3 -[#blue]-> R1 : <<satisfy>>
R4 -[#blue]-> R1 : <<satisfy>>
R5 -[#blue]-> R4 : <<derive>>
R6 -[#blue]-> R2 : <<satisfy>>
R6 -[#blue]-> R3 : <<verify>>

note right of R1
  Authentification via Kerberos/LDAP
  et gestion des sessions utilisateur.
end note

note left of R3
  Déploiement idempotent sur WinRM/SSH
  depuis un orchestrateur Ansible.
end note

note bottom of R6
  Inventaire des postes, RAM, CPU, logiciel,
  suivi de conformité et rapports.
end note

@enduml
