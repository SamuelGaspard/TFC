@startuml
"Diagramme d'exigences" as Title

left to right direction
skinparam linetype ortho
skinparam ArrowColor DarkBlue
skinparam ArrowFontSize 11
skinparam ArrowThickness 2
skinparam class {
  BackgroundColor LightBlue
  BorderColor DarkBlue
  FontSize 12
  Padding 8
}

package "Exigences du système de gestion de parc" {
  rectangle "R1\nAuthentification" as R1
  rectangle "R2\nIdentités" as R2
  rectangle "R3\nDéploiement" as R3
  rectangle "R4\nSécurité" as R4
  rectangle "R5\nCorrectifs" as R5
  rectangle "R6\nReporting" as R6
}

' Organiser la disposition pour réduire les chevauchements
R1 -[hidden]-> R2
R2 -[hidden]-> R3
R3 -[hidden]-> R4
R4 -[hidden]-> R5
R5 -[hidden]-> R6

' Relations visibles avec labels et couleurs
R2 -[#0000CC,thickness=2]-> R1 : refine
R3 -[#006600,thickness=2]-> R1 : satisfy
R4 -[#CC0000,thickness=2]-> R1 : satisfy
R5 -[#CC6600,thickness=2]-> R4 : derive
R6 -[#6600CC,thickness=2]-> R2 : satisfy
R6 -[#006699,thickness=2]-> R3 : verify

note right of R1
  Authentification via Kerberos/LDAP
  et gestion des sessions utilisateur.
end note

note left of R3
  Déploiement idempotent sur WinRM/SSH
  depuis un orchestrateur Ansible.
end note

note bottom of R6
  Inventaire des postes, RAM, CPU, logiciel,
  suivi de conformité et rapports.
end note

@enduml
