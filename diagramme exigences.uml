@startuml
!theme plain
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle
left to right direction

title Diagramme d'Exigences - Système de Gestion Centralisée (Ansible + Active Directory)

' ============================================
' DÉFINITION DES EXIGENCES
' ============================================

' --- Exigences Fonctionnelles ---
package "Exigences Fonctionnelles (EF)" #LightBlue {
    requirement EF1 "Authentification centralisée" 
    requirement EF2 "Gestion des comptes utilisateurs"
    requirement EF3 "Déploiement automatisé d'applications"
    requirement EF4 "Application des politiques de sécurité"
    requirement EF5 "Patching automatique (mises à jour)"
    requirement EF6 "Inventaire matériel et logiciel"
    requirement EF7 "Rapports de conformité"
    requirement EF8 "Exécution ad-hoc de commandes"
    requirement EF9 "Isolation réseau (VLAN + pare-feu)"
    requirement EF10 "Traçabilité des actions"
}

' --- Exigences Non-Fonctionnelles ---
package "Exigences Non-Fonctionnelles (ENF)" #LightGreen {
    requirement ENF1 "Disponibilité (redondance)"
    requirement ENF2 "Sécurité (chiffrement)"
    requirement ENF3 "Performance"
    requirement ENF4 "Extensibilité"
    requirement ENF5 "Maintenabilité (versionnement)"
    requirement ENF6 "Compatibilité OS"
    requirement ENF7 "Traçabilité centralisée"
    requirement ENF8 "Résilience réseau (cache AD)"
}

' --- Contraintes Techniques (Pare-feu) ---
package "Contraintes Pare-feu (VyOS/OPNsense)" #LightYellow {
    requirement CT1 "Isolation VLAN 10/20/30"
    requirement CT2 "Autoriser SSH port 22 (Linux)"
    requirement CT3 "Autoriser WinRM port 5986 (Windows)"
    requirement CT4 "Blocage des autres flux inter-VLAN"
}

' ============================================
' FONCTIONNALITÉS DU SYSTÈME
' ============================================

package "Fonctionnalités du Système" #White {
    
    ' --- Groupe Authentification & Accès ---
    package "Authentification & Accès" {
        feature F1 "Authentification unique (AD)"
        feature F2 "Création/suppression comptes (AD)"
        feature F3 "Gestion droits (sudo/administrateur)"
    }
    
    ' --- Groupe Automatisation ---
    package "Automatisation & Déploiement" {
        feature F4 "Déploiement applications (Windows)"
        feature F5 "Déploiement applications (Linux)"
        feature F6 "Patching automatique sécurité"
        feature F7 "Mode simulation (--check)"
        feature F8 "Exécution ad-hoc (commandes)"
    }
    
    ' --- Groupe Supervision ---
    package "Supervision & Inventaire" {
        feature F9 "Collecte RAM/CPU/OS"
        feature F10 "Inventaire logiciels installés"
        feature F11 "Rapport conformité (HTML/JSON)"
        feature F12 "Alertes (mises à jour manquantes)"
    }
    
    ' --- Groupe Sécurité Réseau ---
    package "Sécurité Réseau (VyOS)" {
        feature F13 "Routage inter-VLAN"
        feature F14 "Règles SSH (port 22)"
        feature F15 "Règles WinRM (port 5986)"
        feature F16 "Blocage flux non autorisés"
    }
}

' ============================================
' LIENS DÉPENDANCE : FONCTIONNALITÉ → EXIGENCE
' ============================================

' --- Authentification & Accès ---
F1 --> EF1
F1 --> ENF2
F2 --> EF2
F3 --> EF2

' --- Automatisation & Déploiement ---
F4 --> EF3
F5 --> EF3
F6 --> EF5
F6 --> ENF3
F7 --> ENF5
F8 --> EF8

' --- Supervision & Inventaire ---
F9 --> EF6
F10 --> EF6
F11 --> EF7
F12 --> EF7

' --- Sécurité Réseau ---
F13 --> EF9
F13 --> CT1
F14 --> CT2
F15 --> CT3
F16 --> CT4
F16 --> ENF2

' --- Liens supplémentaires ---
EF10 --> ENF7
ENF1 --> EF4
ENF4 --> EF9
ENF6 --> EF3
ENF8 --> EF1

' ============================================
' NOTES EXPLICATIVES
' ============================================
note right of EF1
  Authentification Windows/Linux
  via Active Directory (LDAP/Kerberos)
end note

note right of EF3
  Ansible Playbooks pour
  .msi (Windows) et .deb/.rpm (Linux)
end note

note right of EF9
  VLAN10: Serveurs (AD+Ansible)
  VLAN20: Clients Windows
  VLAN30: Clients Linux
end note

note bottom of F14
  Protocoles autorisés :
  - SSH (22) pour Linux
  - WinRM (5986) pour Windows
  - ICMP pour test (ping)
end note

@enduml