@startuml
!theme plain
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle
left to right direction

title Diagramme d'Exigences - Système de Gestion Centralisée (Ansible + Active Directory)

' ============================================
' DÉFINITION DES EXIGENCES
' ============================================

' --- Exigences Fonctionnelles ---
package "Exigences Fonctionnelles (EF)" #LightBlue {
    rectangle EF1 "Authentification centralisée" 
    rectangle EF2 "Gestion des comptes utilisateurs"
    rectangle EF3 "Déploiement automatisé d'applications"
    rectangle EF4 "Application des politiques de sécurité"
    rectangle EF5 "Patching automatique (mises à jour)"
    rectangle EF6 "Inventaire matériel et logiciel"
    rectangle EF7 "Rapports de conformité"
    rectangle EF8 "Exécution ad-hoc de commandes"
    rectangle EF9 "Isolation réseau (VLAN + pare-feu)"
    rectangle EF10 "Traçabilité des actions"
}

' --- Exigences Non-Fonctionnelles ---
package "Exigences Non-Fonctionnelles (ENF)" #LightGreen {
    rectangle ENF1 "Disponibilité (redondance)"
    rectangle ENF2 "Sécurité (chiffrement)"
    rectangle ENF3 "Performance"
    rectangle ENF4 "Extensibilité"
    rectangle ENF5 "Maintenabilité (versionnement)"
    rectangle ENF6 "Compatibilité OS"
    rectangle ENF7 "Traçabilité centralisée"
    rectangle ENF8 "Résilience réseau (cache AD)"
}

' --- Contraintes Techniques (Pare-feu) ---
package "Contraintes Pare-feu (VyOS/OPNsense)" #LightYellow {
    rectangle CT1 "Isolation VLAN 10/20/30"
    rectangle CT2 "Autoriser SSH port 22 (Linux)"
    rectangle CT3 "Autoriser WinRM port 5986 (Windows)"
    rectangle CT4 "Blocage des autres flux inter-VLAN"
}

' ============================================
' FONCTIONNALITÉS DU SYSTÈME
' ============================================

package "Fonctionnalités du Système" #White {
    
    ' --- Groupe Authentification & Accès ---
    package "Authentification & Accès" {
        rectangle F1 "Authentification unique (AD)"
        rectangle F2 "Création/suppression comptes (AD)"
        rectangle F3 "Gestion droits (sudo/administrateur)"
    }
    
    ' --- Groupe Automatisation ---
    package "Automatisation & Déploiement" {
        rectangle F4 "Déploiement applications (Windows)"
        rectangle F5 "Déploiement applications (Linux)"
        rectangle F6 "Patching automatique sécurité"
        rectangle F7 "Mode simulation (--check)"
        rectangle F8 "Exécution ad-hoc (commandes)"
    }
    
    ' --- Groupe Supervision ---
    package "Supervision & Inventaire" {
        rectangle F9 "Collecte RAM/CPU/OS"
        rectangle F10 "Inventaire logiciels installés"
        rectangle F11 "Rapport conformité (HTML/JSON)"
        rectangle F12 "Alertes (mises à jour manquantes)"
    }
    
    ' --- Groupe Sécurité Réseau ---
    package "Sécurité Réseau (VyOS)" {
        rectangle F13 "Routage inter-VLAN"
        rectangle F14 "Règles SSH (port 22)"
        rectangle F15 "Règles WinRM (port 5986)"
        rectangle F16 "Blocage flux non autorisés"
    }
}

' ============================================
' LIENS DÉPENDANCE : FONCTIONNALITÉ → EXIGENCE
' ============================================

' --- Authentification & Accès ---
F1 --> EF1
F1 --> ENF2
F2 --> EF2
F3 --> EF2

' --- Automatisation & Déploiement ---
F4 --> EF3
F5 --> EF3
F6 --> EF5
F6 --> ENF3
F7 --> ENF5
F8 --> EF8

' --- Supervision & Inventaire ---
F9 --> EF6
F10 --> EF6
F11 --> EF7
F12 --> EF7

' --- Sécurité Réseau ---
F13 --> EF9
F13 --> CT1
F14 --> CT2
F15 --> CT3
F16 --> CT4
F16 --> ENF2

' --- Liens supplémentaires ---
EF10 --> ENF7
ENF1 --> EF4
ENF4 --> EF9
ENF6 --> EF3
ENF8 --> EF1

' ============================================
' NOTES EXPLICATIVES
' ============================================
note right of EF1
  Authentification Windows/Linux
  via Active Directory (LDAP/Kerberos)
end note

note right of EF3
  Ansible Playbooks pour
  .msi (Windows) et .deb/.rpm (Linux)
end note

note right of EF9
  VLAN10: Serveurs (AD+Ansible)
  VLAN20: Clients Windows
  VLAN30: Clients Linux
end note

note bottom of F14
  Protocoles autorisés :
  - SSH (22) pour Linux
  - WinRM (5986) pour Windows
  - ICMP pour test (ping)
end note

@enduml