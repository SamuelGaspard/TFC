@startuml
skinparam actorStyle awesome
skinparam packageStyle rectangle

actor "Administrateur Système" as Admin #LightBlue
actor "Active Directory" as AD <<System>> #Yellow
actor "Utilisateurs Parc" as Users #LightGreen

package "Plateforme de Gestion Centralisée" {
  usecase "Authentification Centralisée" as UC1
  usecase "Gestion des Identités & Accès" as UC2
  usecase "Déploiement Automatisé d'Applications" as UC3
  usecase "Configuration des Politiques de Sécurité" as UC4
  usecase "Application des Correctifs (Updates)" as UC5
  usecase "Reporting & Monitoring du Parc" as UC6
}

' Relations de l'Admin
Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC6

' Relations de l'AD
UC1 -- AD
UC2 -- AD

' Inclusions et Extensions
UC2 ..> UC1 : <<include>>
UC3 ..> UC1 : <<include>>
UC4 ..> UC1 : <<include>>
UC5 ..> UC4 : <<extend>>

' Lien Utilisateur
Users -- UC1

note right of UC5
  L'extension permet d'appliquer 
  les mises à jour après avoir 
  défini les règles de sécurité.
end note

@endum